# Used only by `pnpm dev:worker`, which runs the Worker and its Durable Objects
# locally in workerd with local state. The Cloudflare provider still asks for
# credentials, so placeholders are enough. Deploys use your real login.
CI=1
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_API_TOKEN=local-development
