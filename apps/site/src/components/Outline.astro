---
// A static outline drawn with the outliner's own marks: fold triangles,
// bullets, guide lines, mention chips, tags, and the badges agents leave.
// Branches fold with <details>, so it works without JavaScript.
export type Badge =
  | { kind: "working" | "needs" | "done"; agent: string; label: string }
  | { kind: "review"; agent: string; label: string }
  | { kind: "tally"; needs?: number; review?: number };

export type Row = {
  text: string;
  children?: ReadonlyArray<Row>;
  folded?: boolean;
  /** An agent's suggestion, waiting for review. */
  suggested?: boolean;
  badge?: Badge;
};

interface Props {
  rows: ReadonlyArray<Row>;
  label?: string;
}
const { rows, label } = Astro.props;

const AGENTS: Record<string, string> = {
  claude: "Cl",
  cursor: "Cu",
  codex: "Cx",
  conductor: "Co",
};

/** Mentions become chips and tags go quiet, as they do in the outliner. */
const tokens = (text: string) =>
  text
    .split(/((?:^|(?<=\s))[@#][a-z][a-z0-9_-]*)/giu)
    .filter(Boolean)
    .map((part) =>
      part.startsWith("@") && part.slice(1).toLowerCase() in AGENTS
        ? { kind: "mention", text: part, agent: part.slice(1).toLowerCase() }
        : part.startsWith("#")
          ? { kind: "tag", text: part }
          : { kind: "text", text: part },
    );
---

<div class="ol" aria-label={label}>
  {rows.map((row) => {
    const content = (
      <>
        <span class="ol__dot" aria-hidden="true">
          {row.suggested ? "+" : ""}
        </span>
        <span class="ol__text">
          {tokens(row.text).map((token) =>
            token.kind === "mention" ? (
              <span class="mention" data-agent={token.agent}>
                {token.text}
              </span>
            ) : token.kind === "tag" ? (
              <span class="tag">{token.text}</span>
            ) : (
              token.text
            ),
          )}
        </span>
        {row.badge?.kind === "tally" ? (
          <span class="ol__badges">
            {row.badge.needs ? (
              <span class="tally" data-kind="needs">
                <i aria-hidden="true" />
                {row.badge.needs}
                <span class="sr-only"> need you</span>
              </span>
            ) : null}
            {row.badge.review ? (
              <span class="tally" data-kind="review">
                <i aria-hidden="true" />
                {row.badge.review}
                <span class="sr-only"> to review</span>
              </span>
            ) : null}
          </span>
        ) : row.badge ? (
          <span class="ol__badges">
            <span class="chip" data-kind={row.badge.kind}>
              <span class="avatar" data-agent={row.badge.agent}>
                {AGENTS[row.badge.agent]}
              </span>
              {row.badge.kind === "review" ? null : <i aria-hidden="true" />}
              {row.badge.label}
            </span>
          </span>
        ) : row.suggested ? (
          <span class="ol__review" aria-label="Suggestion: accept or reject">
            <span aria-hidden="true">✓</span>
            <span aria-hidden="true">×</span>
          </span>
        ) : null}
      </>
    );
    return row.children?.length ? (
      <details class="ol__branch" open={!row.folded}>
        <summary class="ol__row" data-suggested={row.suggested}>
          <span class="ol__toggle" aria-hidden="true">
            <svg viewBox="0 0 9 9">
              <path d="M2 1l5 3.5L2 8z" />
            </svg>
          </span>
          {content}
        </summary>
        <Astro.self rows={row.children} />
      </details>
    ) : (
      <div class="ol__row" data-suggested={row.suggested}>
        <span class="ol__toggle" aria-hidden="true" />
        {content}
      </div>
    );
  })}
</div>
