---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  /** The current page, shown after the brand like the outline's document name. */
  crumb?: string;
}
const {
  title = "ThreadVM — An outline you think in. Agents that work beside you.",
  description = "An open exploration of software work: from a thought in an outline to an isolated agent workspace, with humans in the loop.",
  crumb = "Field notes",
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImage = Astro.site
  ? new URL("/screenshots/outline.png", Astro.site).href
  : "/screenshots/outline.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#09090b"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content="ThreadVM local outline with inline proposals and an Inbox for review"
    />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="960" />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ThreadVM home">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">ThreadVM</span>
        <span class="brand-doc">{crumb}</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a class="nav-pill" href="/#demo">Demo</a>
        <a class="nav-pill" href="/#idea">The idea</a>
        <a class="nav-pill" href="/#notes">Notes</a>
      </nav>
      <div class="site-header__end">
        <a class="button button-ghost" href="https://github.com/bjacobso/threadvm">
          Source <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="hints" aria-label="Outline shortcuts">
        <span><kbd>Return</kbd> new bullet</span>
        <span><kbd>Tab</kbd> nest</span>
        <span><kbd>@</kbd> ask an agent</span>
      </div>
      <div class="site-footer__links">
        <span class="live"><span class="live__dot" aria-hidden="true"></span>An ongoing, open-source exploration</span>
        <a href="https://github.com/bjacobso/threadvm">Follow along on GitHub ↗</a>
      </div>
    </footer>
  </body>
</html>
