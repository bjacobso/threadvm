{
  "name": "@threadvm/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "pnpm --filter @threadvm/outline build:embed",
    "dev": "pnpm run demo && astro dev --host 0.0.0.0",
    "build": "pnpm run demo && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "typecheck": "astro check",
    "lint": "astro check"
  },
  "dependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@threadvm/outline": "workspace:*",
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
