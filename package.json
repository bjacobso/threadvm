{
  "name": "threadvm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --filter=@threadvm/server --filter=@threadvm/outline",
    "dev:stable": "turbo dev:stable --filter=@threadvm/server --filter=@threadvm/outline",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test --filter=@threadvm/* && pnpm probe:boundaries && pnpm probe:web-style && pnpm probe:terminal-ui",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --disable-nested-config --write .",
    "fmt:check": "oxfmt --disable-nested-config --check .",
    "probe:terminal": "pnpm build && pnpm probe:boundaries && pnpm probe:web-style && node scripts/terminal_probe.mjs && pnpm probe:terminal-ui",
    "probe:boundaries": "pnpm exec tsx scripts/workspace_boundary_probe.ts",
    "probe:dev": "node scripts/dev_probe.mjs",
    "probe:web-style": "pnpm exec tsx scripts/web_style_probe.ts",
    "probe:terminal-ui": "pnpm exec tsx --tsconfig apps/web/tsconfig.json scripts/terminal_ui_probe.ts",
    "start": "pnpm --filter @threadvm/server start",
    "probe:outline": "pnpm build && pnpm exec tsx scripts/outline_probe.ts",
    "probe:outline-ui": "pnpm build && node scripts/outline_ui_probe.mjs",
    "probe:acp": "pnpm build && pnpm exec tsx packages/agent/test/runtime_probe.ts && node scripts/acp_probe.mjs",
    "probe:local-ui": "pnpm build && node scripts/local_harness_ui_probe.mjs",
    "dev:site": "pnpm --filter @threadvm/site dev",
    "build:site": "pnpm --filter @threadvm/site build",
    "check:site": "pnpm --filter @threadvm/site typecheck",
    "probe:site": "node scripts/site_probe.mjs",
    "deploy:site": "pnpm --filter @threadvm/site run deploy --stage prod",
    "plan:site": "pnpm --filter @threadvm/site run plan --stage prod"
  },
  "devDependencies": {
    "effect": "^4.0.0-beta.94",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.20.0"
}
